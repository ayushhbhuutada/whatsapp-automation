{
  "name": "whatsapp-automation-suite",
  "version": "1.0.0",
  "description": "WhatsApp Automation & Anti-Ban Commercial Desktop Edition",
  "author": "WhatsApp Automation Pro Team",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "start": "node backend/server.js",
    "start:electron": "electron .",
    "build": "cd frontend && npm install && npm run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:electron": "npm --prefix frontend run build && electron-builder --win nsis",
    "build:installer": "npm --prefix frontend run build && electron-builder --win nsis",
    "build:exe": "npm --prefix frontend run build && electron-builder --win nsis",
    "dist": "npm --prefix frontend run build && electron-builder --win nsis"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "googleapis": "^144.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.44.0",
    "puppeteer": "^24.1.0",
    "puppeteer-core": "^24.1.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "sql.js": "^1.14.2",
    "whatsapp-web.js": "^1.26.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "30.0.0",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.whatsapp.automation.pro",
    "productName": "WhatsApp Automation",
    "electronVersion": "30.0.0",
    "artifactName": "WhatsAppAutomationSetup.${ext}",
    "directories": {
      "output": "dist_electron",
      "buildResources": "electron"
    },
    "files": [
      "backend/**/*",
      "frontend/dist/**/*",
      "database/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": false,
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "WhatsAppAutomation",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WhatsApp Automation",
      "runAfterFinish": true
    }
  }
}
